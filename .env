# LabVault Configuration
HUB_HOST=0.0.0.0
HUB_PORT=8000
HUB_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./labvault.db

# JWT
SECRET_KEY=your-secret-key-change-this-in-production-please-use-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_PATH=./storage
DATA_ZONE_PATH=./storage/data
COLLAB_ZONE_PATH=./storage/collab

# Permissions
PERMISSION_EXPIRY_WARNING_DAYS=30,7,1

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
